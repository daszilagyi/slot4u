APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://slot4u.test

# Central (apex) domain anchoring tenant subdomains ({tenant}.slot4u.test)
# and the superadmin panel (admin.slot4u.test). See docs/01.
APP_CENTRAL_DOMAIN=slot4u.test
# Egyedi tenant-domain (SLO-42): mire kell CNAME-elni. Üresen hagyva a tenant
# saját {slug}.{central} aldoménje a cél — dev/teszt alatt ez a jó érték.
# ÉLESBEN a Cloudflare for SaaS fallback originje (docs/01, SLO-135):
# APP_CUSTOM_DOMAIN_TARGET=customers.slot4u.hu
APP_CUSTOM_DOMAIN_TARGET=

# Cloudflare for SaaS custom hostname provisioning (SLO-135). Üresen hagyva az
# app egyetlen kimenő hívást sem tesz, és az egyedi domain verifikált marad,
# de tanúsítvány nélkül. Token scope: Zone -> SSL and Certificates -> Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# A Cloudflare Origin Rule átírja a Host headert a fallback originre, a valódi
# látogatói hostot pedig ez a fejléc hozza (Transform Rule). Csak megbízható
# proxy (Cloudflare-tartomány) mögül vesszük figyelembe.
APP_ORIGINAL_HOST_HEADER=X-Slot4u-Original-Host

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot shares the session cookie across tenant subdomains (single login).
SESSION_DOMAIN=.slot4u.test

# Realtime broadcasting via Laravel Reverb (SLO-117). Run the server with
# `docker compose --profile workers up -d reverb` (port 8080). The VITE_* vars
# are read by the browser Echo client (frontend, SLO-116 2nd slice).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=slot4u
REVERB_APP_KEY=slot4u-key
REVERB_APP_SECRET=slot4u-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Pennant resolves tenant features per request from our own tables; the in-memory
# `array` store avoids a second cache that would go stale (docs/01).
PENNANT_STORE=array

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR — the public pages are server-rendered for SEO (docs/01). A
# separate node process runs the built bundle (`bootstrap/ssr/ssr.js`) and the
# app calls it over HTTP. In the Docker stack the renderer is the `ssr` service,
# so set INERTIA_SSR_URL=http://ssr:13714 there. throw_on_error stays false in
# prod/dev (graceful client-side fallback); tests/CI flip it to true to fail loud.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_THROW_ON_ERROR=false
