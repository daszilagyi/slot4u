APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://slot4u.test

# Central (apex) domain anchoring tenant subdomains ({tenant}.slot4u.test)
# and the superadmin panel (admin.slot4u.test). See docs/01.
APP_CENTRAL_DOMAIN=slot4u.test
# A landing „nézd meg működés közben" gombjának célja (SLO-50): a seedelt demo
# tenant slugja. Üresen hagyva a landing egyáltalán nem jelenít meg demo linket
# — egy 404-be futó első kattintás többe kerül, mint a hiányzó gomb.
# Lokálisan `acme` (ezt seedeli a TenantDemoSeeder); ÉLESBEN `demo`, ami a
# config default is — a prod .env-ben ezért nem kell külön beállítani.
APP_DEMO_TENANT_SLUG=acme
# Egyedi tenant-domain (SLO-42): mire kell CNAME-elni. Üresen hagyva a tenant
# saját {slug}.{central} aldoménje a cél — dev/teszt alatt ez a jó érték.
# ÉLESBEN a Cloudflare for SaaS fallback originje (docs/01, SLO-135):
# APP_CUSTOM_DOMAIN_TARGET=customers.slot4u.hu
APP_CUSTOM_DOMAIN_TARGET=

# Cloudflare for SaaS custom hostname provisioning (SLO-135). Üresen hagyva az
# app egyetlen kimenő hívást sem tesz, és az egyedi domain verifikált marad,
# de tanúsítvány nélkül. Token scope: Zone -> SSL and Certificates -> Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# A Cloudflare Origin Rule (vagy Worker) átírja a Host headert a fallback
# originre, a valódi látogatói hostot pedig ez a fejléc hozza.
APP_ORIGINAL_HOST_HEADER=X-Slot4u-Original-Host

# Megosztott titok az edge és az app között (SLO-140). Ha ki van töltve, a
# fenti fejlécet CSAK akkor hisszük el, ha az edge ezt a titkot is bemutatja —
# a REMOTE_ADDR-től függetlenül. Ez kell az osztott tárhelyen, ahol az Apache
# már a valódi látogatói IP-re írja át a REMOTE_ADDR-t, így egyetlen kérés sem
# tűnik megbízható proxy mögülinek. Üresen hagyva a régi, proxy-alapú bizalom
# marad érvényben (dev, CI). Generálás: openssl rand -hex 32
APP_ORIGINAL_HOST_SECRET_HEADER=X-Slot4u-Origin-Secret
APP_ORIGINAL_HOST_SECRET=

# Deploy (SLO-152, docs/16). A kiadott verziót a deploy script írja a gitignore-olt
# `.release` fájlba; az APP_RELEASE csak felülbírálat. A token nélkül a
# GET /_deploy/health 404-et ad — ezt a deploy utáni füstteszt használja annak
# igazolására, hogy a VÁRT verzió szolgál ki és nincs lefuttatatlan migráció.
# Generálás: openssl rand -hex 32
APP_RELEASE=
DEPLOY_HEALTH_TOKEN=

# Monitoring (SLO-153, docs/17). DSN nélkül a Sentry SDK egyetlen kimenő hívást
# sem tesz — dev/CI teljesen néma. A VITE_SENTRY_DSN build-time ég a bundle-be
# (docs/16 §3.3), a szerver a CSP connect-src miatt is ismeri.
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Dead man's switch: külső heartbeat-monitor URL-je (healthchecks.io, Better
# Stack...). A `monitor:health` CSAK akkor pingeli, ha minden ellenőrzés átment
# — a riasztás a ping HIÁNYA, mert az az egyetlen jel, amit egy halott host is
# el tud küldeni. Üresen nincs kimenő hívás.
MONITORING_HEARTBEAT_URL=
MONITORING_QUEUE_STALE_MINUTES=15
MONITORING_FAILED_JOBS_THRESHOLD=1

# A slot4u SAJÁT GA4 mérőazonosítója a marketing-oldalra (SLO-172). Üresen
# semmilyen tag nem kerül a HTML-be — dev és CI ezért néma, és pont ezért NINCS
# default érték: egy repóba égetett prod ID-vel minden fejlesztői gép az éles
# propertybe mérne, és a hamis forgalom csak akkor tűnne fel, amikor valaki
# elkezdene hinni egy számnak. Élesben: G-10EPJ99W18
#
# Csak a központi domainen (slot4u.hu) és csak elfogadott analytics-consenttel
# jelenik meg. Tenant-aldoménen SOHA: ott a tenant az adatkezelő (docs/19 §2).
ANALYTICS_GA4_MEASUREMENT_ID=

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot shares the session cookie across tenant subdomains (single login).
SESSION_DOMAIN=.slot4u.test

# Realtime broadcasting via Laravel Reverb (SLO-117). Run the server with
# `docker compose --profile workers up -d reverb` (port 8080). The VITE_* vars
# are read by the browser Echo client (frontend, SLO-116 2nd slice).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=slot4u
REVERB_APP_KEY=slot4u-key
REVERB_APP_SECRET=slot4u-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Pennant resolves tenant features per request from our own tables; the in-memory
# `array` store avoids a second cache that would go stale (docs/01).
PENNANT_STORE=array

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Offsite backup target (SLO-154, docs/18). Any S3-compatible provider — the
# point is that it is NOT the web host, so losing the hosting account does not
# lose the backups. Backblaze B2 / Wasabi need AWS_ENDPOINT set as well.
# Empty credentials mean `backup:run` makes no outbound call at all (dev, CI).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The dump holds every customer's name, email and phone. Without a passphrase it
# is protected only by the bucket being private. ⚠ Keep the passphrase in a
# password manager too — it lives in this file, and this file is not in the
# backup, so losing the host would otherwise lose the ability to decrypt.
BACKUP_PASSPHRASE=
# BACKUP_DISK=s3
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR — the public pages are server-rendered for SEO (docs/01). A
# separate node process runs the built bundle (`bootstrap/ssr/ssr.js`) and the
# app calls it over HTTP. In the Docker stack the renderer is the `ssr` service,
# so set INERTIA_SSR_URL=http://ssr:13714 there. throw_on_error stays false in
# prod/dev (graceful client-side fallback); tests/CI flip it to true to fail loud.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_THROW_ON_ERROR=false
